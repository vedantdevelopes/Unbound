# ─── Supabase (required) ─────────────────────────────────────────────────────
# Your Supabase project URL and anon (public) key.
# These are safe to expose client-side — security is enforced via RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Encryption (required for data-at-rest encryption) ───────────────────────
# A base64-encoded 256-bit secret used to derive per-collection AES-256-GCM keys.
# Generate one with: openssl rand -base64 32
# If omitted, the app still works but data is stored as plaintext.
ENCRYPTION_MASTER_SECRET=your-base64-secret-here

# ─── Migration (optional) ────────────────────────────────────────────────────
# Secret token required to access /api/migrate-encrypt and /api/migrate-books.
# Only needed for one-time data migrations.
MIGRATION_SECRET=your-migration-secret-here
